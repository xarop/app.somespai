{
  "name": "app.somespai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "export": "next build",
    "postexport": "node ./scripts/ghpages-redirect.js",
    "deploy:gh-pages": "next build && npm run postexport && npx gh-pages -d out",
    "db:status": "bun run scripts/sync-db.ts status",
    "db:pull": "bun run scripts/sync-db.ts pull",
    "db:push": "bun run scripts/sync-db.ts push",
    "db:push:force": "bun run scripts/sync-db.ts push --force",
    "import:all": "bun run scripts/mass-import.ts",
    "import:plan": "bun run scripts/mass-import.ts --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@vercel/analytics": "^2.0.1",
    "maplibre-gl": "^4.7.1",
    "next": "15.3.9",
    "next-intl": "^3.25.0",
    "react": "19.0.0-rc-66855b96-20241106",
    "react-dom": "19.0.0-rc-66855b96-20241106",
    "supercluster": "^8.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supercluster": "^7.1.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.14.0",
    "eslint-config-next": "15.3.9",
    "gh-pages": "^6.3.0",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3"
  }
}
