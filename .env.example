# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Brand (Somespai by default; set to "somtallers" for the Somtallers deployment)
NEXT_PUBLIC_BRAND=somespai

# Optional: set different build directories when running both brands locally.
# NEXT_BUILD_DIR=.next
# NEXT_PUBLIC_SOMESPAI_URL=http://localhost:3001

# Local UI testing only (uses an in-file mock database, not Supabase).
# NEXT_PUBLIC_MOCK_DB=false

# Service role (server only — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Map tiles (MapTiler free tier or Protomaps URL)
NEXT_PUBLIC_MAP_TILES_URL=https://api.maptiler.com/maps/dataviz/style.json?key=YOUR_KEY

# Nominatim reverse geocoder (geo-autofill)
NOMINATIM_USER_AGENT=somespai/1.0 (somespai@xarop.com)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Google Places API (server-only — Branch 3 admin imports)
GOOGLE_PLACES_API_KEY=
